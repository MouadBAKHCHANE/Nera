# Envoi des formulaires (devis et contact) par Microsoft Graph, voir lib/mail.ts.
# Tenant et application : fournis par l'informatique de NERA. Le secret ne se commite jamais :
# il se pose dans Vercel (Settings > Environment Variables) et dans .env.local pour les tests.
# Il expire le 24 septembre 2027.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=noreply@nera-ing.ch
MAIL_TO=info@nera-ing.ch

# Actualités (Sanity), à renseigner lors de la mise en place du CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
